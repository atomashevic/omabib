#!/usr/bin/env python3
"""Fetch one cached-or-live alphaXiv overview on a separate library connection."""
import json
import pathlib
import runpy
import sys

library_call = runpy.run_path(str(pathlib.Path(__file__).with_name('omabib-quick-note')))['library_call']

if __name__ == '__main__':
    try:
        print(json.dumps(library_call(sys.argv[1], 'get_alphaxiv_overview', {'id': sys.argv[2]})), flush=True)
    except Exception as error:
        print(json.dumps({'error': str(error)}), flush=True)
        sys.exit(1)
