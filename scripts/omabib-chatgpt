#!/usr/bin/env python3
"""Open ChatGPT Desktop with an Omabib entry, skill and workspace MCP config."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
from urllib.parse import urlencode

shared = runpy.run_path(str(Path(__file__).with_name('omabib-codex')))


def desktop_context(socket_path, ref_id, project_id, parent=None):
    if parent is None:
        data = Path(os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local/share')))
        parent = data / 'omabib/chatgpt' / hashlib.sha256(socket_path.encode()).hexdigest()[:12] / 'Omabib'
    folder, context = shared['prepare'](socket_path, ref_id, project_id, parent)
    binary = shutil.which('omabib')
    if not binary:
        raise RuntimeError('Omabib executable is unavailable.')
    config_dir = folder.parent / '.codex'
    config_dir.mkdir(mode=0o700, exist_ok=True)
    config = config_dir / 'config.toml'
    config.write_text('model = "gpt-5.6-sol"\nmodel_reasoning_effort = "medium"\n\n[mcp_servers.omabib]\nenabled = true\ncommand = ' + json.dumps(binary) + '\nargs = ["mcp"]\n\n[mcp_servers.omabib.env]\nOMABIB_SOCKET = ' + json.dumps(socket_path) + '\n')
    config.chmod(0o600)
    skill_source = Path.home() / '.codex/skills/omabib/SKILL.md'
    if not skill_source.is_file():
        skill_source = Path(__file__).resolve().parent.parent / 'skills/omabib/SKILL.md'
    skill_dir = folder.parent / '.agents/skills/omabib'
    skill_dir.mkdir(parents=True, mode=0o700, exist_ok=True)
    shutil.copyfile(skill_source, skill_dir / 'SKILL.md')
    (skill_dir / 'SKILL.md').chmod(0o600)
    prompt = '$omabib\n\n' + shared['chat_prompt'](folder, context)
    url = 'codex://threads/new?' + urlencode(dict(mode='codex', path=str(folder.parent), prompt=prompt))
    return folder, url


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('socket_path')
    parser.add_argument('ref_id')
    parser.add_argument('project_id', nargs='?', default='')
    parser.add_argument('--prepare-only', action='store_true')
    args = parser.parse_args()
    app = shutil.which('chatgpt')
    if not app:
        raise RuntimeError('ChatGPT Desktop is not installed (chatgpt command missing).')
    folder, url = desktop_context(args.socket_path, args.ref_id, args.project_id)
    if not args.prepare_only:
        subprocess.Popen([app, url], start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(json.dumps(dict(opened=not args.prepare_only, context_path=str(folder / 'context.json'), url=url if args.prepare_only else None)), flush=True)


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print(json.dumps({'error': str(error)}), flush=True)
        sys.exit(1)
