#!/usr/bin/env python3
"""Install the release backend, or remove it without touching the library."""
import argparse
import fcntl
import hashlib
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PLUGIN_ID = 'io.github.atomashevic.omabib'
HELPERS = ('omabib-close-first', 'omabib-chatgpt', 'omabib-codex',
           'omabib-overview', 'omabib-settings', 'omabib-claude')


def state_path():
    return Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state') / 'omabib/backend.json'


def manifest():
    data = json.loads((ROOT / 'manifest.json').read_text())
    if data.get('id') != PLUGIN_ID or not re.fullmatch(r'\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?', data.get('version', '')):
        raise ValueError('Invalid Omabib plugin manifest')
    return data


def status():
    version = manifest()['version']
    binary = Path.home() / '.local/bin/omabib'
    try:
        installed = json.loads(state_path().read_text())
        result = subprocess.run([str(binary), '--version'], capture_output=True, text=True, timeout=10)
        ready = (installed.get('plugin_id') == PLUGIN_ID and installed.get('version') == version
                 and result.returncode == 0 and result.stdout.strip() == f'omabib {version}'
                 and all((binary.parent / name).is_file() for name in HELPERS))
    except (OSError, ValueError, subprocess.SubprocessError):
        ready = False
    # The standalone app, installed beside the backend, shows Omabib instead
    # of the shell.
    desktop = binary.parent / 'omabib-desktop'
    return {'ready': ready, 'version': version,
            'desktop': str(desktop) if ready and os.access(desktop, os.X_OK) else ''}


def download(url, destination):
    request = urllib.request.Request(url, headers={'User-Agent': 'Omabib-plugin'})
    try:
        with urllib.request.urlopen(request, timeout=60) as response, destination.open('wb') as output:
            total = 0
            while chunk := response.read(1024 * 1024):
                total += len(chunk)
                if total > 512 * 1024 * 1024:
                    raise ValueError('Release download exceeds the size limit')
                output.write(chunk)
    except urllib.error.HTTPError as error:
        if error.code == 404:
            raise ValueError('This version is not available yet. Try again after its release is published.') from error
        raise


def verify_and_extract(archive, checksums, destination, version):
    expected_name = f'omabib-{version}-linux-x86_64.tar.gz'
    matches = [line.split()[0] for line in checksums.read_text().splitlines()
               if len(line.split()) == 2 and line.split()[1] == expected_name]
    if len(matches) != 1:
        raise ValueError('The release checksum is missing or ambiguous. Please retry.')
    with archive.open('rb') as stream:
        actual = hashlib.file_digest(stream, 'sha256').hexdigest()
    if actual != matches[0]:
        raise ValueError('The download was incomplete or changed. Please retry.')
    top = expected_name.removesuffix('.tar.gz')
    with tarfile.open(archive) as tar:
        for member in tar.getmembers():
            parts = Path(member.name).parts
            if (not parts or parts[0] != top or '..' in parts
                    or not (member.isfile() or member.isdir())):
                raise ValueError('The release archive has an unsupported layout')
        tar.extractall(destination, filter='data')
    package = destination / top
    data = json.loads((package / 'manifest.json').read_text())
    if data.get('id') != PLUGIN_ID or data.get('version') != version:
        raise ValueError('The downloaded release does not match this plugin')
    return package


def checked(*command):
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode:
        raise ValueError((result.stderr or result.stdout or 'Setup failed').strip()[-2000:])


def install(local_archive=None):
    if platform.system() != 'Linux' or platform.machine() not in ('x86_64', 'amd64'):
        raise ValueError('Prebuilt installation supports Linux x86-64. See the README for source builds.')
    version = manifest()['version']
    with tempfile.TemporaryDirectory(prefix='omabib-backend-') as temporary:
        scratch = Path(temporary)
        if local_archive:
            archive = local_archive.resolve()
            checksums = archive.parent / 'SHA256SUMS'
        else:
            name = f'omabib-{version}-linux-x86_64.tar.gz'
            base = f'https://github.com/atomashevic/omabib/releases/download/v{version}'
            archive, checksums = scratch / name, scratch / 'SHA256SUMS'
            download(f'{base}/SHA256SUMS', checksums)
            download(f'{base}/{name}', archive)
        package = verify_and_extract(archive, checksums, scratch / 'unpacked', version)
        checked('bash', str(package / 'scripts/install.sh'), '--backend-only')
    result = status()
    if not result['ready']:
        raise ValueError('Setup completed but the backend is not ready. Please retry.')
    return result


def config_home():
    return Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')


def data_home():
    return Path(os.environ.get('XDG_DATA_HOME') or Path.home() / '.local/share')


def plugin_dir():
    return config_home() / 'omarchy/plugins' / PLUGIN_ID


def unit_path():
    # install.sh writes the unit here, under $HOME/.config, not $XDG_CONFIG_HOME.
    return Path.home() / '.config/systemd/user/omabib.service'


def quit_desktop():
    desktop = Path.home() / '.local/bin/omabib-desktop'
    if not os.access(desktop, os.X_OK):
        return
    # A missing window exits non-zero. Uninstall still continues.
    try:
        subprocess.run([str(desktop), '--quit'], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


def stop_service():
    unit = unit_path()
    if not unit.is_file():
        return
    checked('systemctl', '--user', 'disable', '--now', 'omabib.service')
    unit.unlink()
    checked('systemctl', '--user', 'daemon-reload')


def remove_files():
    bin_dir = Path.home() / '.local/bin'
    if bin_dir.is_dir():
        for path in list(bin_dir.iterdir()):
            if path.name.startswith('omabib') and (path.is_symlink() or path.is_file()):
                path.unlink()
    # The app and its own Qt, from release archives that bundle them.
    shutil.rmtree(Path.home() / '.local/lib/omabib', ignore_errors=True)
    data = data_home()
    (data / 'applications/omabib.desktop').unlink(missing_ok=True)
    icons = data / 'icons/hicolor'
    if icons.is_dir():
        for icon in icons.glob('*/apps/omabib.*'):
            if icon.is_file() and icon.suffix in ('.png', '.svg'):
                icon.unlink()


def remove_plugin():
    """Remove a plugin this installer wrote. A Git checkout stays."""
    directory = plugin_dir()
    if not directory.is_dir() or directory.is_symlink():
        return ''
    if (directory / '.git').exists():
        return f'omarchy plugin remove {PLUGIN_ID}'
    if (directory / '.omabib-managed').is_file():
        shutil.rmtree(directory)
    return ''


def remove_backend():
    # The library (~/.local/share/omabib) and settings (~/.config/omabib) stay.
    quit_desktop()
    stop_service()
    remove_files()
    hint = remove_plugin()
    state_path().unlink(missing_ok=True)
    message = 'Omabib backend removed. Your library and settings are preserved.'
    if hint:
        print(hint, file=sys.stderr)
        message = f'{message} {hint}'
    return {'removed': True, 'message': message}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('status', 'install', 'remove-backend'))
    parser.add_argument('--archive', type=Path, help='Install a local release archive with adjacent SHA256SUMS')
    args = parser.parse_args()
    try:
        if args.action == 'status':
            result = status()
        else:
            lock_path = state_path().with_suffix('.lock')
            lock_path.parent.mkdir(parents=True, exist_ok=True)
            with lock_path.open('w') as lock:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    raise ValueError('Another Omabib setup is running. Please wait and retry.') from None
                result = install(args.archive) if args.action == 'install' else remove_backend()
        print(json.dumps(result))
    except (OSError, ValueError, tarfile.TarError, subprocess.SubprocessError) as error:
        print(json.dumps({'ready': False, 'error': str(error)}))
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
