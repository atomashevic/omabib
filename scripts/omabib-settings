#!/usr/bin/env python3
"""Read and change Omabib's desktop preferences: PDF page colors and the chat apps.

Preferences live in $XDG_CONFIG_HOME/omabib/settings.json:

  pdf_colors  PDF pages in reader tabs: "original" or "theme" (Omarchy theme colors)
  ai_cli      terminal chat: "codex" (Codex CLI) or "claude" (Claude Code)
  ai_desktop  desktop chat: "chatgpt" (ChatGPT Desktop) or "claude" (Claude Desktop)
  chat_steps  in-window chat: agent commands and tool calls "hidden" or "shown"
  claude_model, claude_effort, codex_model, codex_effort
              model and effort for new in-window chats; "" is the agent's default

  omabib-settings                      print preferences and the available choices
  omabib-settings set KEY VALUE [KEY VALUE ...]
                                       change preferences, all or none
  omabib-settings register-codex [SOCKET]
                                       connect Codex and install the bundled Omabib skill
  omabib-settings register-claude-desktop SOCKET
                                       add Omabib's MCP server to Claude Desktop
"""
import json
import os
import re
from pathlib import Path
import shutil
import sys
import subprocess

# An older pdf_viewer key is ignored: PDFs open in Omabib's reader tabs.
DEFAULTS = {'pdf_colors': 'original', 'ai_cli': 'codex', 'ai_desktop': 'chatgpt', 'chat_steps': 'hidden',
            'claude_model': '', 'claude_effort': '', 'codex_model': '', 'codex_effort': ''}
CHAT_STEPS = ('hidden', 'shown')
EFFORTS = ('', 'none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra')
PDF_COLORS = ('original', 'theme')
CLIS = [('codex', 'Codex CLI', 'codex'), ('claude', 'Claude Code', 'claude')]
DESKTOPS = [('chatgpt', 'ChatGPT Desktop', 'chatgpt'), ('claude', 'Claude Desktop', 'claude-desktop')]


def config_home():
    return Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')


def settings_path():
    return config_home() / 'omabib/settings.json'


def claude_desktop_config_path():
    return config_home() / 'Claude/claude_desktop_config.json'


def load():
    settings = dict(DEFAULTS)
    try:
        stored = json.loads(settings_path().read_text())
        if isinstance(stored, dict):
            settings.update({k: v for k, v in stored.items() if k in DEFAULTS and isinstance(v, str)})
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    return settings


def write_json(path, value, mode=0o644):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + '.tmp')
    temporary.write_text(json.dumps(value, indent=2, ensure_ascii=False) + '\n')
    temporary.chmod(mode)
    temporary.replace(path)


def claude_desktop_registered():
    try:
        config = json.loads(claude_desktop_config_path().read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return False
    return isinstance(config.get('mcpServers'), dict) and 'omabib' in config['mcpServers']


def library_socket():
    return os.environ.get('OMABIB_SOCKET') or str(Path(os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}') / 'omabib/socket')


def codex_connection(socket_path=None):
    if not shutil.which('codex'):
        return dict(state='unavailable', message='Install Codex CLI to connect your library.')
    binary = shutil.which('omabib')
    if not binary:
        return dict(state='unavailable', message='Install Omabib to connect your library.')
    try:
        result = subprocess.run(['codex', 'mcp', 'list', '--json'], capture_output=True, text=True, timeout=15)
        if result.returncode:
            raise ValueError('Codex configuration could not be read')
        servers = json.loads(result.stdout)
        if not isinstance(servers, list) or not all(isinstance(item, dict) for item in servers):
            raise ValueError('Unexpected MCP configuration')
        existing = next((item for item in servers if item.get('name') == 'omabib'), None)
        if existing is None:
            return dict(state='missing', message='Connect Codex to use your library in any Codex session.')
        transport = existing.get('transport') or {}
        command = transport.get('command') or ''
        match = (existing.get('enabled') is True and transport.get('type') == 'stdio'
                 and os.path.realpath(shutil.which(command) or command) == os.path.realpath(binary)
                 and transport.get('args') == ['mcp']
                 and (transport.get('env') or {}).get('OMABIB_SOCKET') == (socket_path or library_socket()))
        if match:
            return dict(state='connected', message='Codex is connected. Reopen existing sessions to load the tools.')
        return dict(state='custom', message='Codex already has a different Omabib connection. Inspect it with codex mcp get omabib --json.')
    except (OSError, ValueError, TypeError, subprocess.SubprocessError):
        return dict(state='error', message='Could not read Codex settings. Check codex mcp list --json, then retry.')


def register_codex(socket_path=None):
    socket_path = socket_path or library_socket()
    connection = codex_connection(socket_path)
    if connection['state'] not in ('missing', 'connected'):
        raise RuntimeError(connection['message'])
    sources = [Path(__file__).resolve().parent.parent / 'skills/omabib/SKILL.md',
               Path(os.environ.get('XDG_DATA_HOME') or Path.home() / '.local/share') / 'omabib/skills/omabib/SKILL.md']
    source = next((path for path in sources if path.is_file()), None)
    if source is None:
        raise RuntimeError('The bundled Omabib skill is missing. Reinstall Omabib, then reconnect.')
    binary = shutil.which('omabib')
    service = subprocess.run([binary, 'status'], env=dict(os.environ, OMABIB_SOCKET=socket_path),
                             capture_output=True, text=True, timeout=15)
    if service.returncode:
        raise RuntimeError('Open Omabib to start its service, then reconnect Codex.')
    if connection['state'] == 'missing':
        result = subprocess.run(['codex', 'mcp', 'add', 'omabib', '--env', f'OMABIB_SOCKET={socket_path}',
                                 '--', binary, 'mcp'], capture_output=True, text=True, timeout=15)
        if result.returncode:
            raise RuntimeError('Codex could not save the connection. Check its configuration, then retry.')
    if codex_connection(socket_path)['state'] != 'connected':
        raise RuntimeError('Codex did not confirm the connection. Check codex mcp get omabib --json.')
    destination = Path(os.environ.get('CODEX_HOME') or Path.home() / '.codex') / 'skills/omabib/SKILL.md'
    destination.parent.mkdir(parents=True, exist_ok=True)
    if source.resolve() != destination.resolve():
        shutil.copy2(source, destination)


def show():
    settings = load()
    return dict(
        settings=settings,
        path=str(settings_path()),
        clis=[dict(id=i, name=n, available=bool(shutil.which(b))) for i, n, b in CLIS],
        desktops=[dict(id=i, name=n, available=bool(shutil.which(b))) for i, n, b in DESKTOPS],
        claude_desktop_mcp=claude_desktop_registered(),
        codex_mcp=codex_connection(),
    )


def check(key, value):
    if key not in DEFAULTS:
        raise ValueError(f'Unknown setting {key}')
    if key == 'pdf_colors' and value not in PDF_COLORS:
        raise ValueError('PDF colors must be original or theme')
    if key == 'ai_cli' and value not in {i for i, _, _ in CLIS}:
        raise ValueError('Terminal chat must be codex or claude')
    if key == 'ai_desktop' and value not in {i for i, _, _ in DESKTOPS}:
        raise ValueError('Desktop chat must be chatgpt or claude')
    if key == 'chat_steps' and value not in CHAT_STEPS:
        raise ValueError('Chat steps must be hidden or shown')
    if key.endswith('_effort') and value not in EFFORTS:
        raise ValueError(f'Unknown effort level {value}')
    if key.endswith('_model') and not re.fullmatch(r'(?:[A-Za-z0-9][A-Za-z0-9._:/\[\]-]{0,99})?', value):
        raise ValueError('Invalid model name')


def set_values(pairs):
    for key, value in pairs:
        check(key, value)
    settings = load()
    settings.update(pairs)
    write_json(settings_path(), settings)


def register_claude_desktop(socket_path):
    """Merge an `omabib` MCP server into Claude Desktop's config, keeping everything else."""
    binary = shutil.which('omabib')
    if not binary:
        raise RuntimeError('The omabib executable is not on PATH.')
    path = claude_desktop_config_path()
    config = {}
    if path.exists():
        config = json.loads(path.read_text())
        if not isinstance(config, dict):
            raise ValueError(f'{path} is not a JSON object')
        backup = path.with_name(path.name + '.omabib-backup')
        if not backup.exists():
            shutil.copy2(path, backup)
    servers = config.get('mcpServers')
    if not isinstance(servers, dict):
        servers = {}
    servers['omabib'] = dict(command=binary, args=['mcp'], env=dict(OMABIB_SOCKET=socket_path))
    config['mcpServers'] = servers
    write_json(path, config, mode=path.stat().st_mode & 0o777 if path.exists() else 0o600)


def main(argv):
    if argv[:1] == ['set'] and len(argv) >= 3 and len(argv) % 2 == 1:
        set_values(list(zip(argv[1::2], argv[2::2])))
    elif argv[:1] == ['register-codex'] and len(argv) in (1, 2):
        socket_path = argv[1] if len(argv) == 2 else library_socket()
        register_codex(socket_path)
        os.environ['OMABIB_SOCKET'] = socket_path
    elif argv[:1] == ['register-claude-desktop'] and len(argv) == 2:
        register_claude_desktop(argv[1])
    elif argv not in ([], ['show']):
        raise SystemExit(__doc__)
    print(json.dumps(show()), flush=True)


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except SystemExit:
        raise
    except Exception as error:
        print(json.dumps({'error': str(error)}), flush=True)
        sys.exit(1)
