#!/usr/bin/env python3
"""Read and change Omabib's desktop preferences: PDF page colors and the chat apps.

Preferences live in $XDG_CONFIG_HOME/omabib/settings.json:

  theme        "system" (follow light or dark), "light", "dark" or "omarchy"
               (the active Omarchy theme). A new config chooses omarchy when
               ~/.local/state/omarchy/current/theme/colors.toml parses.
               system, light or dark already written in the file stay there.
  reading_font paper titles, abstracts and notes: "sans" or "serif"
  pdf_colors  PDF pages in reader tabs: "original" or "theme" (the theme's colors)
  ai_cli      terminal chat: "codex" (Codex CLI) or "claude" (Claude Code)
  ai_desktop  desktop chat: "chatgpt" (ChatGPT Desktop) or "claude" (Claude Desktop)
  chat_steps  in-window chat: agent commands and tool calls "hidden" or "shown"
  claude_model, claude_effort, codex_model, codex_effort
              model and effort for new in-window chats; "" is the agent's default
  agent_setup "" until connect-agents has run once (the welcome page runs it), then "done"

  omabib-settings                      print preferences and the available choices
  omabib-settings set KEY VALUE [KEY VALUE ...]
                                       change preferences, all or none
  omabib-settings register-codex [SOCKET]
                                       connect Codex and install the bundled Omabib skill
  omabib-settings register-claude-code [SOCKET]
                                       connect Claude Code and install the bundled Omabib skill
  omabib-settings register-claude-desktop SOCKET
                                       add Omabib's MCP server to Claude Desktop
  omabib-settings connect-agents [SOCKET]
                                       connect every agent found that isn't connected yet,
                                       leaving other Omabib connections alone
"""
import json
import os
import re
from pathlib import Path
import shutil
import sys
import subprocess

# An older pdf_viewer key is ignored: PDFs open in Omabib's reader tabs.
DEFAULTS = {'theme': 'system', 'reading_font': 'sans', 'pdf_colors': 'original', 'ai_cli': 'codex', 'ai_desktop': 'chatgpt', 'chat_steps': 'hidden',
            'claude_model': '', 'claude_effort': '', 'codex_model': '', 'codex_effort': '', 'agent_setup': ''}
CHAT_STEPS = ('hidden', 'shown')
EFFORTS = ('', 'none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra')
PDF_COLORS = ('original', 'theme')
THEMES = ('system', 'light', 'dark', 'omarchy')
COLOR_LINE = re.compile(r"""^\s*([A-Za-z0-9_-]+)\s*=\s*["']?(#[0-9A-Fa-f]{6})""")
READING_FONTS = ('sans', 'serif')
CLIS = [('codex', 'Codex CLI', 'codex'), ('claude', 'Claude Code', 'claude')]
DESKTOPS = [('chatgpt', 'ChatGPT Desktop', 'chatgpt'), ('claude', 'Claude Desktop', 'claude-desktop')]


def config_home():
    return Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')


def settings_path():
    return config_home() / 'omabib/settings.json'


def claude_desktop_config_path():
    # Claude Desktop on macOS reads Application Support, not XDG.
    if sys.platform == 'darwin':
        return Path.home() / 'Library/Application Support/Claude/claude_desktop_config.json'
    return config_home() / 'Claude/claude_desktop_config.json'


def omarchy_colors_path():
    return Path.home() / '.local/state/omarchy/current/theme/colors.toml'


def omarchy_colors_parse(path=None):
    """True when colors.toml has a background and a foreground, as Color.qml reads them."""
    path = omarchy_colors_path() if path is None else Path(path)
    try:
        text = path.read_text()
    except OSError:
        return False
    values = {}
    for line in text.splitlines():
        match = COLOR_LINE.match(line)
        if match:
            values[match.group(1)] = match.group(2)
    return bool((values.get('background') or values.get('color0')) and (values.get('foreground') or values.get('color7')))


def load():
    settings = dict(DEFAULTS)
    explicit_theme = False
    try:
        stored = json.loads(settings_path().read_text())
        if isinstance(stored, dict):
            theme = stored.get('theme')
            explicit_theme = isinstance(theme, str) and theme in THEMES
            settings.update({k: v for k, v in stored.items() if k in DEFAULTS and isinstance(v, str)})
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    if not explicit_theme and omarchy_colors_parse():
        settings['theme'] = 'omarchy'
    return settings


def write_json(path, value, mode=0o644):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + '.tmp')
    temporary.write_text(json.dumps(value, indent=2, ensure_ascii=False) + '\n')
    temporary.chmod(mode)
    temporary.replace(path)


def claude_code_paths():
    """Claude Code's user settings file (MCP servers) and its personal skills folder."""
    base = os.environ.get('CLAUDE_CONFIG_DIR')
    if base:
        return Path(base) / '.claude.json', Path(base) / 'skills'
    return Path.home() / '.claude.json', Path.home() / '.claude/skills'


def claude_desktop_available():
    if shutil.which('claude-desktop'):
        return True
    if sys.platform == 'darwin' and Path('/Applications/Claude.app').exists():
        return True
    return claude_desktop_config_path().parent.is_dir()


def claude_desktop_registered():
    try:
        config = json.loads(claude_desktop_config_path().read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return False
    return isinstance(config.get('mcpServers'), dict) and 'omabib' in config['mcpServers']


def library_socket():
    return os.environ.get('OMABIB_SOCKET') or str(Path(os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}') / 'omabib/socket')


def codex_connection(socket_path=None):
    if not shutil.which('codex'):
        return dict(state='unavailable', message='Install Codex CLI to connect your library.')
    binary = shutil.which('omabib')
    if not binary:
        return dict(state='unavailable', message='Install Omabib to connect your library.')
    try:
        result = subprocess.run(['codex', 'mcp', 'list', '--json'], capture_output=True, text=True, timeout=15)
        if result.returncode:
            raise ValueError('Codex configuration could not be read')
        servers = json.loads(result.stdout)
        if not isinstance(servers, list) or not all(isinstance(item, dict) for item in servers):
            raise ValueError('Unexpected MCP configuration')
        existing = next((item for item in servers if item.get('name') == 'omabib'), None)
        if existing is None:
            return dict(state='missing', message='Connect Codex to use your library in any Codex session.')
        transport = existing.get('transport') or {}
        command = transport.get('command') or ''
        match = (existing.get('enabled') is True and transport.get('type') == 'stdio'
                 and os.path.realpath(shutil.which(command) or command) == os.path.realpath(binary)
                 and transport.get('args') == ['mcp']
                 and (transport.get('env') or {}).get('OMABIB_SOCKET') == (socket_path or library_socket()))
        if match:
            return dict(state='connected', message='Codex is connected. Reopen existing sessions to load the tools.')
        return dict(state='custom', message='Codex already has a different Omabib connection. Inspect it with codex mcp get omabib --json.')
    except (OSError, ValueError, TypeError, subprocess.SubprocessError):
        return dict(state='error', message='Could not read Codex settings. Check codex mcp list --json, then retry.')


def claude_code_connection(socket_path=None):
    if not shutil.which('claude'):
        return dict(state='unavailable', message='Install Claude Code to connect your library.')
    binary = shutil.which('omabib')
    if not binary:
        return dict(state='unavailable', message='Install Omabib to connect your library.')
    config_path, _ = claude_code_paths()
    try:
        config = json.loads(config_path.read_text()) if config_path.exists() else {}
        if not isinstance(config, dict):
            raise ValueError('Unexpected Claude Code configuration')
        servers = config.get('mcpServers') or {}
        if not isinstance(servers, dict):
            raise ValueError('Unexpected MCP configuration')
        existing = servers.get('omabib')
        if existing is None:
            return dict(state='missing', message='Connect Claude Code to use your library in any Claude Code session.')
        command = existing.get('command') or ''
        match = (existing.get('type', 'stdio') == 'stdio'
                 and os.path.realpath(shutil.which(command) or command) == os.path.realpath(binary)
                 and existing.get('args') == ['mcp']
                 and (existing.get('env') or {}).get('OMABIB_SOCKET') == (socket_path or library_socket()))
        if match:
            return dict(state='connected', message='Claude Code is connected. Start a new session to load the tools.')
        return dict(state='custom', message='Claude Code already has a different Omabib connection. Inspect it with claude mcp get omabib.')
    except (OSError, ValueError, TypeError, AttributeError):
        return dict(state='error', message=f'Could not read {config_path}. Check that it is valid JSON, then retry.')


def bundled_skill():
    sources = [Path(__file__).resolve().parent.parent / 'skills/omabib/SKILL.md',
               Path(os.environ.get('XDG_DATA_HOME') or Path.home() / '.local/share') / 'omabib/skills/omabib/SKILL.md']
    source = next((path for path in sources if path.is_file()), None)
    if source is None:
        raise RuntimeError('The bundled Omabib skill is missing. Reinstall Omabib, then reconnect.')
    return source


def install_skill(source, skills_dir):
    destination = skills_dir / 'omabib/SKILL.md'
    destination.parent.mkdir(parents=True, exist_ok=True)
    if source.resolve() != destination.resolve():
        shutil.copy2(source, destination)


# An agent's MCP server is checked against a running library, so the service must answer.
def require_service(binary, socket_path, agent):
    service = subprocess.run([binary, 'status'], env=dict(os.environ, OMABIB_SOCKET=socket_path),
                             capture_output=True, text=True, timeout=15)
    if service.returncode:
        raise RuntimeError(f'Open Omabib to start its service, then reconnect {agent}.')


def register_claude_code(socket_path=None):
    socket_path = socket_path or library_socket()
    connection = claude_code_connection(socket_path)
    if connection['state'] not in ('missing', 'connected'):
        raise RuntimeError(connection['message'])
    source = bundled_skill()
    binary = shutil.which('omabib')
    require_service(binary, socket_path, 'Claude Code')
    if connection['state'] == 'missing':
        server = dict(type='stdio', command=binary, args=['mcp'], env=dict(OMABIB_SOCKET=socket_path))
        result = subprocess.run(['claude', 'mcp', 'add-json', '--scope', 'user', 'omabib', json.dumps(server)],
                                capture_output=True, text=True, timeout=60)
        if result.returncode:
            raise RuntimeError('Claude Code could not save the connection. Check claude mcp list, then retry.')
    if claude_code_connection(socket_path)['state'] != 'connected':
        raise RuntimeError('Claude Code did not confirm the connection. Check claude mcp get omabib.')
    install_skill(source, claude_code_paths()[1])


def register_codex(socket_path=None):
    socket_path = socket_path or library_socket()
    connection = codex_connection(socket_path)
    if connection['state'] not in ('missing', 'connected'):
        raise RuntimeError(connection['message'])
    source = bundled_skill()
    binary = shutil.which('omabib')
    require_service(binary, socket_path, 'Codex')
    if connection['state'] == 'missing':
        result = subprocess.run(['codex', 'mcp', 'add', 'omabib', '--env', f'OMABIB_SOCKET={socket_path}',
                                 '--', binary, 'mcp'], capture_output=True, text=True, timeout=15)
        if result.returncode:
            raise RuntimeError('Codex could not save the connection. Check its configuration, then retry.')
    if codex_connection(socket_path)['state'] != 'connected':
        raise RuntimeError('Codex did not confirm the connection. Check codex mcp get omabib --json.')
    install_skill(source, Path(os.environ.get('CODEX_HOME') or Path.home() / '.codex') / 'skills')


def claude_desktop_connection():
    if claude_desktop_registered():
        return dict(state='connected', message='Claude Desktop has Omabib\'s tools. If you just added them, restart Claude Desktop.')
    if not claude_desktop_available():
        return dict(state='unavailable', message='Install Claude Desktop to connect your library.')
    return dict(state='missing', message='Claude Desktop can\'t see your library yet. Adding Omabib keeps your other Claude Desktop settings and saves a backup.')


def agents(socket_path=None, codex=None):
    return [dict(id='claude-code', name='Claude Code', **claude_code_connection(socket_path)),
            dict(id='codex', name='Codex', **(codex or codex_connection(socket_path))),
            dict(id='claude-desktop', name='Claude Desktop', **claude_desktop_connection())]


def connect_agents(socket_path):
    """Connects each agent that is installed and has no Omabib connection yet.

    One agent's failure doesn't stop the others; its message says what went wrong.
    """
    failures = {}
    for agent in agents(socket_path):
        if agent['state'] != 'missing':
            continue
        try:
            if agent['id'] == 'claude-code':
                register_claude_code(socket_path)
            elif agent['id'] == 'codex':
                register_codex(socket_path)
            else:
                register_claude_desktop(socket_path)
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
            failures[agent['id']] = str(error)
    set_values([('agent_setup', 'done')])
    return failures


def show(failures=None):
    settings = load()
    codex = codex_connection()
    connected = agents(codex=codex)
    for agent in connected:
        if agent['id'] in (failures or {}):
            agent.update(state='error', message=failures[agent['id']])
    return dict(
        settings=settings,
        path=str(settings_path()),
        clis=[dict(id=i, name=n, available=bool(shutil.which(b))) for i, n, b in CLIS],
        desktops=[dict(id=i, name=n, available=bool(shutil.which(b))) for i, n, b in DESKTOPS],
        claude_desktop_mcp=claude_desktop_registered(),
        codex_mcp=codex,
        agents=connected,
    )


def check(key, value):
    if key not in DEFAULTS:
        raise ValueError(f'Unknown setting {key}')
    if key == 'theme' and value not in THEMES:
        raise ValueError('Theme must be system, light, dark or omarchy')
    if key == 'reading_font' and value not in READING_FONTS:
        raise ValueError('Reading font must be sans or serif')
    if key == 'pdf_colors' and value not in PDF_COLORS:
        raise ValueError('PDF colors must be original or theme')
    if key == 'ai_cli' and value not in {i for i, _, _ in CLIS}:
        raise ValueError('Terminal chat must be codex or claude')
    if key == 'ai_desktop' and value not in {i for i, _, _ in DESKTOPS}:
        raise ValueError('Desktop chat must be chatgpt or claude')
    if key == 'chat_steps' and value not in CHAT_STEPS:
        raise ValueError('Chat steps must be hidden or shown')
    if key == 'agent_setup' and value not in ('', 'done'):
        raise ValueError('Agent setup must be "" or done')
    if key.endswith('_effort') and value not in EFFORTS:
        raise ValueError(f'Unknown effort level {value}')
    if key.endswith('_model') and not re.fullmatch(r'(?:[A-Za-z0-9][A-Za-z0-9._:/\[\]-]{0,99})?', value):
        raise ValueError('Invalid model name')


def set_values(pairs):
    for key, value in pairs:
        check(key, value)
    settings = load()
    settings.update(pairs)
    write_json(settings_path(), settings)


def register_claude_desktop(socket_path):
    """Merge an `omabib` MCP server into Claude Desktop's config, keeping everything else."""
    binary = shutil.which('omabib')
    if not binary:
        raise RuntimeError('The omabib executable is not on PATH.')
    path = claude_desktop_config_path()
    config = {}
    if path.exists():
        config = json.loads(path.read_text())
        if not isinstance(config, dict):
            raise ValueError(f'{path} is not a JSON object')
        backup = path.with_name(path.name + '.omabib-backup')
        if not backup.exists():
            shutil.copy2(path, backup)
    servers = config.get('mcpServers')
    if not isinstance(servers, dict):
        servers = {}
    servers['omabib'] = dict(command=binary, args=['mcp'], env=dict(OMABIB_SOCKET=socket_path))
    config['mcpServers'] = servers
    write_json(path, config, mode=path.stat().st_mode & 0o777 if path.exists() else 0o600)


def main(argv):
    failures = None
    if argv[:1] == ['set'] and len(argv) >= 3 and len(argv) % 2 == 1:
        set_values(list(zip(argv[1::2], argv[2::2])))
    elif argv[:1] in (['register-codex'], ['register-claude-code'], ['connect-agents']) and len(argv) in (1, 2):
        socket_path = argv[1] if len(argv) == 2 else library_socket()
        if argv[0] == 'register-codex':
            register_codex(socket_path)
        elif argv[0] == 'register-claude-code':
            register_claude_code(socket_path)
        else:
            failures = connect_agents(socket_path)
        os.environ['OMABIB_SOCKET'] = socket_path
    elif argv[:1] == ['register-claude-desktop'] and len(argv) == 2:
        register_claude_desktop(argv[1])
    elif argv not in ([], ['show']):
        raise SystemExit(__doc__)
    print(json.dumps(show(failures)), flush=True)


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except SystemExit:
        raise
    except Exception as error:
        print(json.dumps({'error': str(error)}), flush=True)
        sys.exit(1)
