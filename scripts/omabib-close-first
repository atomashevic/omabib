#!/usr/bin/env bash
# Omabib is a normal window now, so Super+W closes it like any other. Kept so
# existing `o.rebind("SUPER + W", ..., "omabib-close-first")` bindings keep
# working; the plain Omarchy close binding does the same.
set -euo pipefail
hyprctl dispatch 'hl.dsp.window.close()' >/dev/null
