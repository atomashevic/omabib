#!/usr/bin/env python3
"""Resolve the focused Zathura PDF for Omabib notes or reference opening."""
import argparse
import json
import pathlib
import os
import socket
import subprocess
import sys


def command(*args):
    return subprocess.check_output(args, text=True, timeout=3).strip()


def library_call(socket_path, method, params):
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(3)
        connection.connect(socket_path)
        connection.sendall((json.dumps(dict(v=1, id=1, method=method, params=params)) + '\n').encode())
        response = json.loads(connection.makefile().readline())
    if 'error' in response:
        raise ValueError(response['error']['message'])
    return response['result']


def document_properties(pid):
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    reply = bus.call_sync(
        f'org.pwmt.zathura.PID-{pid}', '/org/pwmt/zathura',
        'org.freedesktop.DBus.Properties', 'GetAll',
        GLib.Variant('(s)', ('org.pwmt.zathura',)), GLib.VariantType('(a{sv})'),
        Gio.DBusCallFlags.NONE, 1500, None)
    return reply.unpack()[0]


def validate_document(active, properties, reference):
    if active.get('class', '').lower() not in ('org.pwmt.zathura', 'zathura'):
        raise ValueError('Focus the PDF in Zathura, then press Super+N.')
    path = pathlib.Path(properties['filename']).resolve(strict=True)
    attachments = reference.get('attachments', [])
    if not any(a.get('file_type') == 'pdf' and pathlib.Path(a['path']).resolve() == path
               for a in attachments):
        raise ValueError('This PDF does not match the reference last opened in Omabib. Open the intended PDF from Omabib first.')
    title = active.get('title', '').strip()
    # Zathura can use the full path, basename, or PDF metadata title, and
    # optionally append a page counter. Exact attachment identity is mandatory.
    names = [str(path), path.name, str(properties['filename']), reference.get('title', '')]
    if not any(name and (title == name or title.startswith(name + ' [') or title == name + ' - Zathura') for name in names):
        raise ValueError('The Zathura window title does not match the active reference. Reopen its PDF from Omabib.')
    page = properties['pagenumber']
    total = properties['numberofpages']
    if not isinstance(page, int) or not isinstance(total, int) or not 0 <= page < total:
        raise ValueError('Zathura did not report a valid PDF page.')
    return str(path), page + 1, total


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--print', action='store_true', help='Validate and print context without opening the editor')
    parser.add_argument('--open-reference', action='store_true', help='Print the Omabib reference matching the active PDF')
    args = parser.parse_args()
    # Capture the foreground window before opening any overlay.
    active = json.loads(command('hyprctl', 'activewindow', '-j'))
    if active.get('class', '').lower() not in ('org.pwmt.zathura', 'zathura'):
        raise ValueError('Focus the PDF in Zathura, then press Super+B.' if args.open_reference
                         else 'Focus the PDF in Zathura, then press Super+N.')
    properties = document_properties(active['pid'])
    if args.open_reference:
        target = os.environ.get('OMABIB_SOCKET', os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}') + '/omabib/socket')
        path = pathlib.Path(properties['filename']).resolve(strict=True)
        match = library_call(target, 'find_reference_by_pdf', dict(path=str(path)))
        reference = library_call(target, 'get_reference', dict(id=match['ref_id'], include_metadata=False))
        after = json.loads(command('hyprctl', 'activewindow', '-j'))
        current = document_properties(active['pid'])
        if after.get('address') != active['address'] or after.get('pid') != active['pid'] or current.get('filename') != properties['filename']:
            raise ValueError('The active PDF changed. Press Super+B again.')
        print(json.dumps(dict(socket_path=target, ref_id=reference['id'], query=reference['citekey'], project_id='')))
        return
    try:
        state = json.loads(command('omarchy-shell', 'omabib', 'state'))
    except Exception:
        state = {}
    if state.get('editor_open'):
        raise ValueError('An Omabib editor is already open. Save or cancel that note first.')
    context = state.get('reading_context') or {}
    reference = None
    default_socket = os.environ.get('OMABIB_SOCKET', os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}') + '/omabib/socket')
    if context.get('ref_id'):
        try:
            reference = library_call(context['socket_path'], 'get_reference',
                                     dict(id=context['ref_id'], include_attachments=True, include_metadata=False))
            validate_document(active, properties, reference)
        except Exception:
            reference = None
    if reference is None:
        failure = None
        for target in dict.fromkeys([context.get('socket_path'), default_socket]):
            if not target:
                continue
            try:
                match = library_call(target, 'find_reference_by_pdf', dict(path=properties['filename']))
                reference = library_call(target, 'get_reference', dict(id=match['ref_id'], include_attachments=True, include_metadata=False))
                validate_document(active, properties, reference)
                context = dict(ref_id=reference['id'], socket_path=target, project_id='')
                break
            except Exception as error:
                failure = error
                reference = None
        if reference is None:
            raise ValueError(f'Cannot link this PDF to Omabib: {failure}')
    path, page, total = validate_document(active, properties, reference)
    # A focus/document switch during lookup must never attach a note elsewhere.
    after = json.loads(command('hyprctl', 'activewindow', '-j'))
    current = document_properties(active['pid'])
    if after.get('address') != active['address'] or after.get('pid') != active['pid'] or current != properties:
        raise ValueError('The active PDF or page changed. Press Super+N again.')
    payload = dict(source_pid=active['pid'], source_window=active['address'], action='quick_note', ref_id=reference['id'], project_id=context.get('project_id', ''),
                   socket_path=context['socket_path'], pdf_path=path, page=page, total_pages=total)
    if args.print:
        print(json.dumps(payload))
    else:
        result = subprocess.run([str(pathlib.Path(__file__).with_name('omabib-capture-note')), json.dumps(payload)], text=True, capture_output=True, timeout=195)
        clip = json.loads(result.stdout)
        if clip.get('cancelled'):
            return
        if clip.get('error'):
            raise ValueError(clip['error'])
        payload['clip'] = clip
        try:
            command('omarchy-shell', 'shell', 'summon', 'omabib', json.dumps(payload))
        except Exception:
            if clip.get('path'):
                subprocess.run([str(pathlib.Path(__file__).with_name('omabib-capture-note')), '--discard', clip['path']], check=False)
            raise


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        opening = '--open-reference' in sys.argv
        print(f'Omabib {"open reference" if opening else "quick note"}: {error}', file=sys.stderr)
        if '--print' not in sys.argv:
            subprocess.run(['notify-send', '-a', 'Omabib', 'Open reference' if opening else 'Quick note', str(error)], check=False)
        sys.exit(1)
