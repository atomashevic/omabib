# The only apt, dnf and pacman names for the libraries a Linux install needs.
# Columns: soname, apt package, dnf package, pacman package.
# scripts/install.sh reads this when it names a missing library.
# scripts/test-get --deps installs the packages that message names, and no others.
# A row whose soname starts with @ is a prefix, used only when no exact row matches.
# A dash means that family has no single package on that system; the soname is printed as itself.

libfontconfig.so.1 libfontconfig1 fontconfig fontconfig
libfreetype.so.6 libfreetype6 freetype freetype2
